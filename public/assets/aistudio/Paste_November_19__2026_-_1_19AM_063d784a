<!-- Client-side Interactive Reading Experience Micro-interactions -->
<script>
    (function initReaderInteractions() {
      // Paper Tint Switching
      const canvas = document.getElementById('reader-canvas');
      const tintParchment = document.getElementById('tint-parchment');
      const tintRose = document.getElementById('tint-rose');
      const tintMidnight = document.getElementById('tint-midnight');
      const tintButtons = [tintParchment, tintRose, tintMidnight];

      function setActiveTint(activeBtn, bgClass) {
        tintButtons.forEach(btn => {
          btn.classList.remove('scale-110', 'ring-2', 'ring-primary/60');
          btn.classList.add('ring-1', 'ring-outline-variant/40');
        });
        activeBtn.classList.add('scale-110', 'ring-2', 'ring-primary/60');
        activeBtn.classList.remove('ring-1', 'ring-outline-variant/40');
        
        canvas.className = canvas.className.replace(/bg-\[[^\]]+\]|bg-surface-bright/g, '');
        canvas.classList.add(bgClass);
      }

      if (tintParchment) {
        tintParchment.addEventListener('click', () => setActiveTint(tintParchment, 'bg-[#fdf9f3]'));
      }
      if (tintRose) {
        tintRose.addEventListener('click', () => setActiveTint(tintRose, 'bg-[#fff0f3]'));
      }
      if (tintMidnight) {
        tintMidnight.addEventListener('click', () => setActiveTint(tintMidnight, 'bg-[#272320]'));
      }

      // Font Style Switching
      const readerText = document.getElementById('reader-text');
      const fontSerifBtn = document.getElementById('font-serif-btn');
      const fontSansBtn = document.getElementById('font-sans-btn');
      const fontMonoBtn = document.getElementById('font-mono-btn');
      const fontButtons = [fontSerifBtn, fontSansBtn, fontMonoBtn];

      function setActiveFont(btn, fontClass) {
        fontButtons.forEach(b => {
          b.className = 'font-mode-btn px-2.5 py-1 rounded-full text-on-surface-variant hover:text-on-surface font-label-sm text-[11px] transition-colors';
        });
        btn.className = 'font-mode-btn px-2.5 py-1 rounded-full bg-surface-container-highest text-primary font-headline-sm text-[12px] font-semibold transition-colors';
        
        readerText.classList.remove('font-body-lg', 'font-sans', 'font-mono');
        readerText.classList.add(fontClass);
      }

      if (fontSerifBtn) fontSerifBtn.addEventListener('click', () => setActiveFont(fontSerifBtn, 'font-body-lg'));
      if (fontSansBtn) fontSansBtn.addEventListener('click', () => setActiveFont(fontSansBtn, 'font-sans'));
      if (fontMonoBtn) fontMonoBtn.addEventListener('click', () => setActiveFont(fontMonoBtn, 'font-mono'));

      // Font Size Scale
      let currentScale = 100;
      const indicator = document.getElementById('font-size-indicator');
      const incBtn = document.getElementById('increase-font');
      const decBtn = document.getElementById('decrease-font');

      if (incBtn && decBtn && indicator) {
        incBtn.addEventListener('click', () => {
          if (currentScale < 130) {
            currentScale += 10;
            indicator.textContent = currentScale + '%';
            readerText.style.fontSize = (currentScale / 100 * 1.125) + 'rem';
          }
        });
        decBtn.addEventListener('click', () => {
          if (currentScale > 80) {
            currentScale -= 10;
            indicator.textContent = currentScale + '%';
            readerText.style.fontSize = (currentScale / 100 * 1.125) + 'rem';
          }
        });
      }

      // Twitter Like Heart Trigger
      const tweetHeart = document.getElementById('tweet-heart');
      const heartCount = document.getElementById('heart-count');
      let liked = false;
      if (tweetHeart && heartCount) {
        tweetHeart.addEventListener('click', () => {
          let count = parseInt(heartCount.textContent, 10);
          liked = !liked;
          heartCount.textContent = liked ? (count + 1) : (count - 1);
          tweetHeart.classList.toggle('text-secondary', liked);
        });
      }

      // Kudos Author Coffee Button Micro-interaction
      const kudosBtn = document.getElementById('kudos-btn');
      const kudosCounter = document.getElementById('kudos-counter');
      if (kudosBtn && kudosCounter) {
        kudosBtn.addEventListener('click', () => {
          let currentCups = 1420;
          currentCups += 1;
          kudosCounter.textContent = currentCups.toLocaleString('id-ID') + ' cangkir dituangkan ✨';
          kudosBtn.classList.add('bg-secondary');
          setTimeout(() => kudosBtn.classList.remove('bg-secondary'), 600);
        });
      }

      // Interactive Poll Option Selection
      const pollBox = document.getElementById('poll-box');
      if (pollBox) {
        const pollButtons = pollBox.querySelectorAll('.poll-opt');
        pollButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            pollButtons.forEach(b => b.classList.remove('ring-2', 'ring-secondary', 'font-bold'));
            btn.classList.add('ring-2', 'ring-secondary', 'font-bold');
          });
        });
      }

      // Reading Progress dynamically tracked
      window.addEventListener('scroll', () => {
        const docElem = document.documentElement;
        const totalHeight = docElem.scrollHeight - docElem.clientHeight;
        if (totalHeight > 0) {
          const scrollPercent = Math.min(100, Math.max(0, Math.round((window.scrollY / totalHeight) * 100)));
          const progressText = document.getElementById('progress-text');
          if (progressText) {
            progressText.textContent = scrollPercent + '%';
          }
        }
      });
    })();
  </script>
